# ----------------------------------------------------------------------
# SEGURIDAD ESTRICTA (OPTIMIZADA) - DERECHOS ART CONSULTAS
# ----------------------------------------------------------------------

# 1. DESACTIVAR EL LISTADO DE DIRECTORIOS
Options -Indexes

# 2. BLOQUEO DE ARCHIVOS SENSIBLES POR EXTENSION
# Bloquea archivos ocultos (.env, .git, etc.), backups y temporales, composer.json/lock
# Se hace excepción para /.well-known/ (SSL, verificación de dominios)
<FilesMatch "^(?:\.(?!well-known).*|.*\.(?:bak|config|sql|log|ini|sh|inc|swp|dist)|composer\.(?:json|lock))$">
    Require all denied
</FilesMatch>

# ========== COMPRESION GZIP ==========
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/x-javascript image/svg+xml
    AddEncoding gzip .gz
</IfModule>

# ========== CACHÉ DEL NAVEGADOR ==========
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/gif "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType text/html "access plus 1 hour"
    ExpiresByType application/font-woff2 "access plus 30 days"
</IfModule>

# ========== HEADERS DE SEGURIDAD Y CACHE ==========
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header unset Permissions-Policy

    # CACHE EFICIENTE PARA RECURSOS ESTATICOS (1 ANO / 31536000 SEG)
    <FilesMatch "\.(ico|pdf|flv|jpg|jpeg|png|gif|webp|js|css|swf|svg|woff|woff2|eot|ttf)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # FORZAR NO-CACHE PARA LA PAGINA DE CONTACTO (ASEGURA VER MENSAJE DE EXITO)
    SetEnvIf Request_URI "/contacto$" NO_CACHE
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0" env=NO_CACHE
    Header set Pragma "no-cache" env=NO_CACHE
</IfModule>

# 2. FORZAR HTTPS Y NO-WWW (PARA EVITAR PERDIDA DE SESION)
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 3. BLOQUEO DE ATAQUES COMUNES (WORDPRESS, ETC)

# A. FORZAR HTTPS (REDIRECCION PERMANENTE 301)
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# B. FORZAR NO-WWW (UNIFICAR VERSION CANONICA SEGUN SITEMAP)
RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
RewriteRule ^(.*)$ https://%1%{REQUEST_URI} [R=301,L]

# B2. ELIMINAR INDEX.PHP DE LA URL (CANONICALIZACION)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.php\ HTTP/
RewriteRule ^index\.php$ https://derechosart.com.ar/ [L,R=301]

# C. REDIRECCION 301 DEL DOMINIO VIEJO AL NUEVO (DERECHOSARTCONSULTAS.COM)
RewriteCond %{HTTP_HOST} ^(www\.)?derechosartconsultas\.com$ [NC]
RewriteRule ^(.*)$ https://derechosart.com.ar/$1 [R=301,L]

# Bloquear intentos de acceso a WordPress y otros escaneos
RewriteCond %{REQUEST_URI} ^/wp-.* [NC,OR]
RewriteCond %{REQUEST_URI} ^/xmlrpc\.php [NC,OR]
RewriteCond %{REQUEST_URI} ^/phpmyadmin [NC,OR]
RewriteCond %{REQUEST_URI} ^/\.env [NC,OR]
RewriteCond %{REQUEST_URI} ^/backup [NC,OR]
RewriteCond %{REQUEST_URI} ^/inicializar_db\.php [NC]
RewriteRule ^(.*)$ - [F,L]

# 3b. BLOQUEO DE RUTAS CRÍTICAS DETECTADAS EN LOGS
RewriteCond %{REQUEST_URI} ^/\.git [NC,OR]
RewriteCond %{REQUEST_URI} ^/_ignition/execute-solution [NC,OR]
RewriteCond %{REQUEST_URI} ^/\.aws [NC,OR]
RewriteCond %{REQUEST_URI} ^/aws\.env [NC,OR]
RewriteCond %{REQUEST_URI} ^/\.env\.(production|local|save|bak) [NC,OR]
RewriteCond %{REQUEST_URI} ^/(admin|backend)/\.env [NC,OR]
RewriteCond %{REQUEST_URI} ^/config(\.php|\.php\.bak|\.js|\.json.*) [NC,OR]
RewriteCond %{REQUEST_URI} ^/aws(-config|\.config)\.js [NC,OR]
RewriteCond %{REQUEST_URI} ^/phpinfo(\.php.*)? [NC]
RewriteRule ^(.*)$ - [F,L]

# 4. BLOQUEAR ACCESO DIRECTO A CUALQUIER .PHP (EXCEPTO INDEX.PHP)
# Solo bloquea requests directos al navegador, no includes del servidor
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /.*\.php [NC]
RewriteCond %{REQUEST_FILENAME} !index\.php [NC]
RewriteRule ^ - [F,L]

# 5. PROTEGER CARPETAS DE CODIGO
RewriteRule ^(config|src|vendor|vistas|aplicacion)/ - [F,L]

# 6. REDIRECCION DE FUENTES (Compatibilidad con rutas viejas)
RewriteRule ^fuentes/(.*)$ publico/fuentes/$1 [L,R=301]

# 7. RUTAS DE API (Forzar paso por index.php aunque exista el directorio /api)
RewriteRule ^api/(.*)$ index.php [L,QSA]

# 7b. REDIRECCION 301 DE LANDINGS AL FORMATO EN RAIZ (SEO)
RewriteRule ^landings/(abogados-art-.*)$ /$1 [R=301,L,NC]
RewriteRule ^landings/(abogados-despidos-.*)$ /$1 [R=301,L,NC]
RewriteRule ^landings/abogados-art-neuquen$ /abogados-art-neuquen [R=301,L,NC]
RewriteRule ^landings/abogados-art-rosario$ /abogados-art-rosario [R=301,L,NC]
RewriteRule ^landings/abogados-art-salta$ /abogados-art-salta [R=301,L,NC]
RewriteRule ^landings/abogados-art-vista-alegre$ /abogados-art-vista-alegre [R=301,L,NC]
RewriteRule ^landings/vista-alegre$ /abogados-art-vista-alegre [R=301,L,NC]
RewriteRule ^landings/?$ / [R=301,L,NC]

# 7c. FORZAR RUTEO DE /blog A INDEX.PHP (EVITA CONFLICTO CON DIRECTORIO FISICO)
RewriteRule ^blog/?$ index.php [L,QSA]

# 8. RUTEO AMIGABLE (URLs limpias)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [L,QSA]
